FUNCTION_BLOCK MyFB
  VAR x : INT; END_VAR
  x := 0;
END_FUNCTION_BLOCK

FUNCTION MyFun : INT
  MyFun := 0;
END_FUNCTION

PROGRAM MyProgram
  VAR y : INT; END_VAR
  y := 0;
END_PROGRAM

(* The rule's example, after Figure 20 of IEC 61131-3 *)
PROGRAM F
  VAR_INPUT x1 : BOOL; END_VAR
  VAR_OUTPUT y1 : BOOL; END_VAR
  y1 := x1;
END_PROGRAM

PROGRAM G
  VAR_OUTPUT OUT1 : BYTE; END_VAR
  VAR FB1 : TON; FB2 : TON; END_VAR
  OUT1 := 0;
END_PROGRAM

CONFIGURATION config
  VAR_GLOBAL w : BYTE; END_VAR
  RESOURCE res1 ON PLC
    TASK Fast(INTERVAL := T#10ms, PRIORITY := 1);
    TASK Slow(INTERVAL := T#100ms, PRIORITY := 2);
    PROGRAM inst1 WITH Fast : MyProgram;
    PROGRAM inst2 WITH Slow : MyFB; (* CP16 *)
    PROGRAM inst3 : MyProgram;
    PROGRAM inst4 WITH Fast : MyFun; (* CP16 *)
    PROGRAM inst5 WITH Slow : TON; (* CP16 *)
    PROGRAM inst6 WITH Slow : Unknown;
  END_RESOURCE
  RESOURCE STATION_1 ON PROCESSOR_TYPE_1
    VAR_GLOBAL z1 : BYTE; END_VAR
    TASK SLOW_1(INTERVAL := t#20ms, PRIORITY := 2);
    TASK FAST_1(INTERVAL := t#10ms, PRIORITY := 1);
    PROGRAM P1 WITH SLOW_1 : F(x1 := %IX1.1);
    PROGRAM P2 : G(OUT1 => w,
      FB1 WITH SLOW_1, (* CP16 *)
      FB2 WITH FAST_1); (* CP16 *)
  END_RESOURCE
END_CONFIGURATION
