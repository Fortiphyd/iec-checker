{
  "detectors": { "disabled": [], "enabled": [] },
  "thresholds": {
    "mccabe_complexity": 15,
    "mccabe_variant": "standard",
    "statements_count": 25,
    "max_string_length": 4096,
    "duplicate_code_size": 25
  },
  "output": { "format": "plain", "color": true, "min_severity": "low" },
  "input": { "format": "st", "merge": false, "exclude_paths": [] },
  "analysis": { "dump": false, "verbose": false },
  "naming_conventions": {
    "type_prefixes": {
      "INT": "i",
      "BOOL": "x",
      "REAL": "r",
      "ARRAY": "a",
      "FUNCTION_BLOCK": "fb"
    },
    "scope_prefixes": {
      "GLOBAL": "g"
    },
    "case": {
      "variable": "lowerCamelCase",
      "constant": "UPPER_SNAKE_CASE",
      "pou":      "UpperCamelCase",
      "type":     "UpperCamelCase",
      "struct_member": "lowerCamelCase",
      "enum_value": "UPPER_SNAKE_CASE"
    },
    "min_length": 8,
    "min_length_local": 3,
    "max_length": 25,
    "udt_prefixes": {
      "STRUCT":         "ST_",
      "ENUM":           "E_",
      "FUNCTION_BLOCK": "FB_",
      "PROGRAM":        "PRG_"
    }
  }
}
